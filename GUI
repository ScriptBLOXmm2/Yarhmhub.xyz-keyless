-- Loading Logic
local totalTime = 40
local elapsed = 0
local showedMessage = false

spawn(function()
    while elapsed < totalTime do
        wait(0.1)
        elapsed = elapsed + 0.1
        
        local progress = elapsed / totalTime
        local percent = math.floor(progress * 100)
        
        -- Update bar
        BarFill.Size = UDim2.new(progress, 0, 1, 0)
        PercentText.Text = percent .. "%"
        
        -- Show message at 15 seconds
        if elapsed >= 15 and not showedMessage then
            showedMessage = true
            StatusText.Text = "Please wait, assets are loading..."
            StatusText.TextColor3 = Color3.fromRGB(255, 220, 150)
            
            -- Pulse animation
            spawn(function()
                while elapsed < totalTime do
                    local pulse = TweenService:Create(StatusText, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                        TextStrokeTransparency = 0.5,
                        TextColor3 = Color3.fromRGB(255, 255, 200)
                    })
                    pulse:Play()
                    wait(0.5)
                    local pulse2 = TweenService:Create(StatusText, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                        TextStrokeTransparency = 1,
                        TextColor3 = Color3.fromRGB(255, 220, 150)
                    })
                    pulse2:Play()
                    wait(0.5)
                end
            end)
        end
        
        -- Update status based on progress
        if elapsed < 5 then
            StatusText.Text = "Connecting to servers..."
        elseif elapsed < 10 then
            StatusText.Text = "Verifying user data..."
        elseif elapsed < 15 then
            StatusText.Text = "Loading core modules..."
        elseif elapsed < 25 then
            StatusText.Text = "Please wait, assets are loading..."
        elseif elapsed < 35 then
            StatusText.Text = "Finalizing setup..."
        else
            StatusText.Text = "Almost ready..."
        end
        
        -- Rotate tips every 4 seconds
        if math.floor(elapsed) % 4 == 0 and elapsed % 1 < 0.2 then
            local randomTip = tipsList[math.random(1, #tipsList)]
            TipsText.Text = randomTip
            
            -- Fade animation for tip change
            TipsText.TextTransparency = 1
            local fadeIn = TweenService:Create(TipsText, TweenInfo.new(0.3), {
                TextTransparency = 0
            })
            fadeIn:Play()
        end
    end
    
    -- Loading Complete - Transition to Error Screen
    local outTween1 = TweenService:Create(LoadingFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Rotation = 10
    })
    local outTween2 = TweenService:Create(TipsFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    })
    
    outTween1:Play()
    outTween2:Play()
    
    wait(0.5)
    LoadingFrame:Destroy()
    TipsFrame:Destroy()
    
    -- Create Error GUI
    local ErrorFrame = Instance.new("Frame")
